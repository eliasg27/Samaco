{%- assign sitio = 'https://samaco-phi.vercel.app' -%}
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<meta name="color-scheme" content="light">
<title>Samaco</title>
</head>
<body style="margin:0;padding:0;background:#f1f5f9;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;">Gracias por tu compra en Samaco. Acá tenés el detalle.&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f1f5f9">
  <tr><td align="center" style="padding:24px 12px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;">
      <tr><td bgcolor="#1B4F8C" style="padding:22px 28px;border-radius:14px 14px 0 0;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
          <td><a href="{{ sitio }}" target="_blank"><img src="https://samaco-phi.vercel.app/logo-samaco-blanco-mail.png" alt="Samaco" height="36" style="display:block;height:36px;width:auto;border:0;"></a></td>
          
        </tr></table>
      </td></tr>
      <tr><td bgcolor="#ffffff" style="padding:32px 28px 28px;">

<h1 style="font-family:Arial,Helvetica,sans-serif;margin:0 0 12px;font-size:24px;line-height:1.25;color:#1e293b;font-weight:bold;">¡Gracias por tu compra{% if customer.first_name %}, {{ customer.first_name }}{% endif %}!</h1>
<p style="font-family:Arial,Helvetica,sans-serif;margin:0 0 16px;font-size:15px;line-height:1.6;color:#1e293b;">Recibimos tu pedido <strong>{{ order_name }}</strong> y ya lo estamos preparando.{% if financial_status == "pending" %} Lo despachamos apenas se acredite el pago.{% endif %}</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 24px;"><tr><td align="center" width="33%" style="font-family:Arial,Helvetica,sans-serif;padding:0 4px;">
      <div style="height:6px;border-radius:3px;background:#E8593C;"></div>
      <div style="margin-top:8px;font-size:12px;color:#1e293b;font-weight:bold;">Recibido</div>
    </td><td align="center" width="33%" style="font-family:Arial,Helvetica,sans-serif;padding:0 4px;">
      <div style="height:6px;border-radius:3px;background:#e2e8f0;"></div>
      <div style="margin-top:8px;font-size:12px;color:#64748b;">Preparando</div>
    </td><td align="center" width="33%" style="font-family:Arial,Helvetica,sans-serif;padding:0 4px;">
      <div style="height:6px;border-radius:3px;background:#e2e8f0;"></div>
      <div style="margin-top:8px;font-size:12px;color:#64748b;">{% if delivery_method == "pick-up" %}Listo para retirar{% else %}En camino{% endif %}</div>
    </td></tr></table>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 8px;">
  <tr><td bgcolor="#E8593C" style="border-radius:8px;">
    <a href="{{ order_status_url }}" target="_blank" style="font-family:Arial,Helvetica,sans-serif;display:inline-block;padding:14px 28px;font-size:15px;font-weight:bold;color:#ffffff;text-decoration:none;border-radius:8px;">Ver estado del pedido</a>
  </td></tr>
</table>

{%- if delivery_method == 'pick-up' %}
<h2 style="font-family:Arial,Helvetica,sans-serif;margin:28px 0 12px;font-size:13px;letter-spacing:1px;text-transform:uppercase;color:#64748b;font-weight:bold;">Retiro en sucursal</h2>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 8px;">
  <tr><td style="font-family:Arial,Helvetica,sans-serif;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:16px 18px;font-size:14px;line-height:1.6;color:#1e293b;"><strong>{{ shipping_method.title }}</strong><br>Te avisamos por mail cuando esté listo para retirar. Traé el número de pedido <strong>{{ order_name }}</strong> y tu DNI.</td></tr>
</table>
{%- elsif requires_shipping and shipping_address %}
<h2 style="font-family:Arial,Helvetica,sans-serif;margin:28px 0 12px;font-size:13px;letter-spacing:1px;text-transform:uppercase;color:#64748b;font-weight:bold;">Envío a domicilio</h2>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 8px;">
  <tr><td style="font-family:Arial,Helvetica,sans-serif;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:16px 18px;font-size:14px;line-height:1.6;color:#1e293b;"><strong>{{ shipping_method.title }}</strong><br>{{ shipping_address | format_address }}</td></tr>
</table>
{%- endif %}
<h2 style="font-family:Arial,Helvetica,sans-serif;margin:28px 0 12px;font-size:13px;letter-spacing:1px;text-transform:uppercase;color:#64748b;font-weight:bold;">Tu pedido</h2>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
{%- for line in line_items %}
  <tr>
    <td width="64" style="padding:10px 12px 10px 0;border-bottom:1px solid #e2e8f0;vertical-align:top;">
      <img src="{{ line | img_url: 'compact_cropped' }}" alt="" width="56" height="56" style="display:block;width:56px;height:56px;border-radius:8px;border:1px solid #e2e8f0;object-fit:cover;">
    </td>
    <td style="font-family:Arial,Helvetica,sans-serif;padding:10px 0;border-bottom:1px solid #e2e8f0;font-size:14px;line-height:1.4;color:#1e293b;vertical-align:top;">
      <strong>{{ line.product.title | default: line.title }}</strong>
      {%- if line.variant.title != blank and line.variant.title != 'Default Title' %}<br><span style="color:#64748b;">{{ line.variant.title }}</span>{% endif %}
      {%- if line.sku != blank %}<br><span style="font-size:12px;color:#64748b;">Cód. {{ line.sku }}</span>{% endif %}
      <br><span style="color:#64748b;">Cantidad: {{ line.quantity }}</span>
    </td>
    <td align="right" style="font-family:Arial,Helvetica,sans-serif;padding:10px 0 10px 12px;border-bottom:1px solid #e2e8f0;font-size:14px;color:#1e293b;vertical-align:top;white-space:nowrap;">
      {%- if line.final_line_price -%}{{ line.final_line_price | money }}{%- endif -%}
    </td>
  </tr>
{%- endfor %}
</table>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  
<tr>
  <td style="font-family:Arial,Helvetica,sans-serif;padding:6px 0;font-size:14px;color:#64748b;">Subtotal</td>
  <td align="right" style="font-family:Arial,Helvetica,sans-serif;padding:6px 0;font-size:14px;color:#1e293b;">{{ subtotal_price | money }}</td>
</tr>
  {%- if total_discounts > 0 %}
<tr>
  <td style="font-family:Arial,Helvetica,sans-serif;padding:6px 0;font-size:14px;color:#64748b;">Descuentos</td>
  <td align="right" style="font-family:Arial,Helvetica,sans-serif;padding:6px 0;font-size:14px;color:#1e293b;">−{{ total_discounts | money }}</td>
</tr>{% endif %}
  {%- if requires_shipping and delivery_method != 'pick-up' %}
<tr>
  <td style="font-family:Arial,Helvetica,sans-serif;padding:6px 0;font-size:14px;color:#64748b;">Envío</td>
  <td align="right" style="font-family:Arial,Helvetica,sans-serif;padding:6px 0;font-size:14px;color:#1e293b;">{% if shipping_price > 0 %}{{ shipping_price | money }}{% else %}Sin cargo{% endif %}</td>
</tr>{% endif %}
  
<tr>
  <td style="font-family:Arial,Helvetica,sans-serif;padding:6px 0;font-size:17px;color:#1e293b;font-weight:bold;">Total</td>
  <td align="right" style="font-family:Arial,Helvetica,sans-serif;padding:6px 0;font-size:17px;color:#1e293b;font-weight:bold;">{{ total_price | money }}</td>
</tr>
</table>

{%- assign pagos_ok = transactions | where: 'status', 'success' -%}
{%- if pagos_ok.size == 0 %}{% assign pagos_ok = transactions %}{% endif -%}
{%- for t in pagos_ok limit: 1 %}
<p style="font-family:Arial,Helvetica,sans-serif;margin:12px 0 0;font-size:13px;color:#64748b;">{%- assign medio = t.gateway_display_name | default: t.gateway -%}
Pagado con {{ medio }}{% if t.payment_details.credit_card_company and t.payment_details.credit_card_company != medio %} · {{ t.payment_details.credit_card_company }}{% endif %}{% if t.payment_details.credit_card_last_four_digits %} terminada en {{ t.payment_details.credit_card_last_four_digits }}{% endif %}</p>
{%- endfor %}
{%- if attributes.cuit %}<p style="font-family:Arial,Helvetica,sans-serif;margin:8px 0 0;font-size:13px;color:#64748b;">CUIT/DNI para la factura: {{ attributes.cuit }}</p>{% endif %}
<p style="font-family:Arial,Helvetica,sans-serif;margin:16px 0 0;font-size:13px;line-height:1.5;color:#64748b;">La factura te llega por separado. Si necesitás cambiar algo del pedido, escribinos cuanto antes por WhatsApp.</p>
      </td></tr>
      <tr><td bgcolor="#ffffff" style="padding:20px 28px 28px;border-top:1px solid #e2e8f0;border-radius:0 0 14px 14px;">

      <p style="font-family:Arial,Helvetica,sans-serif;margin:0 0 10px;font-size:14px;color:#1e293b;font-weight:bold;">¿Dudas con tu pedido?</p>
      <p style="font-family:Arial,Helvetica,sans-serif;margin:0 0 16px;font-size:14px;line-height:1.7;color:#64748b;">
        <a href="https://wa.me/5492617231255" style="color:#1B4F8C;font-weight:bold;text-decoration:none;">WhatsApp</a>
        &nbsp;·&nbsp; <a href="mailto:ventas@samacoonline.com.ar" style="color:#1B4F8C;text-decoration:none;">ventas@samacoonline.com.ar</a>
        &nbsp;·&nbsp; <a href="{{ sitio }}/sucursales" style="color:#1B4F8C;text-decoration:none;">Sucursales</a>
      </p>
      <p style="font-family:Arial,Helvetica,sans-serif;margin:0;font-size:12px;line-height:1.6;color:#64748b;">
        Samaco · Materiales para la construcción · Mendoza y San Juan<br>
        <a href="{{ sitio }}" style="color:#64748b;">samaco-phi.vercel.app</a>
      </p>
      </td></tr>
    </table>
  </td></tr>
</table>
</body>
</html>
