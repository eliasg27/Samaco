# Copiar a .env.local y completar. Sin credenciales de Shopify, el sitio usa los datos mock (src/services/mock-data.ts).

# Shopify Storefront API (headless). El token es el "Storefront API access token" público
# de la app/canal Headless de la tienda; es seguro que viaje al navegador.
VITE_SHOPIFY_STORE_DOMAIN="samaco.myshopify.com"
VITE_SHOPIFY_STOREFRONT_TOKEN=""
# VITE_SHOPIFY_API_VERSION="2025-07"
# Menú de navegación de Shopify cuyas colecciones son las categorías del sitio.
# VITE_SHOPIFY_MENU_HANDLE="main-menu"

# Forzar datos mock aunque haya credenciales: "mock"
# VITE_COMMERCE_PROVIDER="mock"
